# Publish only runnable A/B source, processed public data and deployment files.
/*
!/.gitignore
!/README.md
!/package.json
!/.github/
!/scripts/
!/site/
!/docs/
/docs/*
!/docs/features/
!/prototypes/
/prototypes/*
!/prototypes/people/
!/prototypes/archives/
/prototypes/people/*
/prototypes/archives/*
!/prototypes/*/src/
!/prototypes/*/public/
!/prototypes/*/tests/
!/prototypes/*/scripts/
!/prototypes/*/data/
/prototypes/*/data/*
!/prototypes/*/data/sources.json
!/prototypes/*/package.json
!/prototypes/*/package-lock.json
!/prototypes/*/tsconfig.json
!/prototypes/*/index.html
!/prototypes/*/index.v1.html
!/prototypes/*/README.md
!/prototypes/*/THIRD_PARTY_NOTICES.md
!/prototypes/*/requirements-docs.txt
**/node_modules/
**/dist/
**/__pycache__/
**/*.log
.env*

